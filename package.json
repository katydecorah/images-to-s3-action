{
  "name": "images-to-s3-action",
  "version": "5.0.0",
  "description": "GitHub action to upload images to S3",
  "main": "dist/index.js",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@aws-sdk/client-s3": "^3.1078.0",
    "@mapbox/appropriate-images": "^6.1.0",
    "@vercel/ncc": "^0.44.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.4",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "pretest": "eslint .",
    "test": "jest --coverage",
    "build": "ncc build src/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "jest": {
    "clearMocks": true,
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "moduleNameMapper": {
      "^@actions/core$": "<rootDir>/__mocks__/actions-core.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
